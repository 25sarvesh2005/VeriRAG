# VeriRAG Configuration Environment Variables

# LLM Provider Configuration (options: mock, openai, gemini, ollama)
VERIRAG_LLM_PROVIDER=mock
VERIRAG_LLM_MODEL=gpt-4o-mini
VERIRAG_OPENAI_API_KEY=
VERIRAG_GEMINI_API_KEY=
VERIRAG_OLLAMA_BASE_URL=http://localhost:11434

# Embedding and Dense Retrieval
VERIRAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
VERIRAG_EMBEDDING_DEVICE=cpu

# Cross-Encoder Reranker
VERIRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VERIRAG_RERANKER_DEVICE=cpu

# Retrieval Hyperparameters
VERIRAG_DENSE_TOP_K=15
VERIRAG_BM25_TOP_K=15
VERIRAG_RRF_K=60
VERIRAG_RERANK_TOP_K=5

# Chunking Configuration
VERIRAG_CHUNK_SIZE_WORDS=200
VERIRAG_CHUNK_OVERLAP_WORDS=40

# Citation & Verification
VERIRAG_MIN_VERIFICATION_CONFIDENCE=0.65

# Server Configuration
VERIRAG_HOST=0.0.0.0
VERIRAG_PORT=8000
